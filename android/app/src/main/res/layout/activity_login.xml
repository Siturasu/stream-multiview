<?xml version="1.0" encoding="utf-8"?>
<!-- In-app login. The header wraps its content and the WebView takes the rest,
     so the same file works on a narrow phone and in a wide DeX window: the
     version line and the status message flex by weight, the site buttons scroll
     sideways when they no longer fit. Touch targets are 44dp tall. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF000000"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/version_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#FF9E9E9E"
            android:maxLines="2" />

        <Button
            android:id="@+id/button_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:minHeight="44dp"
            android:text="@string/login_done"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_chzzk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/login_chzzk" />

            <Button
                android:id="@+id/button_youtube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="44dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/login_youtube" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/status_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#FF9E9E9E" />

        <Button
            android:id="@+id/button_recheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="72dp"
            android:minHeight="44dp"
            android:text="@string/login_recheck"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:textSize="13sp"
        android:textColor="#FFFF6B6B"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hint_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:textSize="13sp"
        android:textColor="#FFFFB300"
        android:text="@string/login_keep_signed_in_hint"
        android:visibility="gone" />

    <Button
        android:id="@+id/diagnostics_toggle"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="start|center_vertical"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textColor="#FF9E9E9E"
        android:text="@string/login_diagnostics_show" />

    <LinearLayout
        android:id="@+id/diagnostics_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/diagnostics_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#FF9E9E9E"
                android:textIsSelectable="true" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <Button
                android:id="@+id/button_copy_diagnostics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="88dp"
                android:minHeight="44dp"
                android:textSize="13sp"
                android:textColor="#FFFFFFFF"
                android:text="@string/login_diagnostics_copy" />

            <Button
                android:id="@+id/button_refresh_diagnostics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="88dp"
                android:minHeight="44dp"
                android:textSize="13sp"
                android:textColor="#FFFFFFFF"
                android:text="@string/login_diagnostics_refresh" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/web_view_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="#FF000000" />
</LinearLayout>
